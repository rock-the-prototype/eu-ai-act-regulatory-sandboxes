    "type": "consultation-form",
    "title": "Targeted stakeholder consultation on the draft implementing act on AI regulatory sandboxes",
    "language": "en",
    "publisher": "European Commission – AI Office",
    "legal_context": "Draft implementing act under Regulation (EU) 2024/1689 (AI Act)",
    "availability": {
      "start_date": "2025-12-02",
      "end_date": "2026-01-13",
      "language_restriction": "English only"
    },
    "notes": [
      "Fields marked with * are mandatory",
      "Responses will be published in aggregated form",
      "Respondents will not be directly quoted"
    ]
  },

  "introduction": {
    "purpose": "The consultation collects stakeholder feedback on the draft implementing act setting out common rules for the establishment and operation of AI regulatory sandboxes under the AI Act.",
    "sandbox_definition": "AI regulatory sandboxes enable prospective providers to develop, train, validate and test innovative AI systems for a limited time under regulatory supervision in a controlled framework, including real-world conditions where appropriate."
  },

